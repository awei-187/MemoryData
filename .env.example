# Copy to .env only if you do not already have one. Never commit real credentials.
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# true lets model requests use HTTP_PROXY / HTTPS_PROXY / NO_PROXY.
OPENAI_API_TRUST_ENV=true

# Memory engines/databases are separate from model serving.
# HINDSIGHT_API_URL=http://127.0.0.1:8888
# HINDSIGHT_API_KEY=
# Former checkout locations (os.pathsep-separated) whose Hindsight states / Mem0 checkpoints may be reused after moving the repo.
# MEMORYDATA_LEGACY_REPO_ROOTS=
# NEO4J_PASSWORD=
